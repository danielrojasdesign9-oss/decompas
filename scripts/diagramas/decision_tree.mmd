    end

    subgraph PRECIO["💰 PRECIO"]
        P1["\"¿Cuánto cobra?\""]
        P2["\"¿Es caro?\""]
        P3["\"¿Hay opciones?\""]
    end

    subgraph DETALLE["❓ DETALLE"]
        D1["\"¿Qué haces exactamente?\""]
        D2["\"¿Cómo funciona?\""]
        D3["\"¿Qué incluye?\""]
    end

    subgraph RECHAZO["❌ RECHAZO"]
        R1["\"No me interesa\""]
        R2["\"No es para mí\""]
        R3["\"Ya tengo alguien\""]
    end

