    subgraph VALOR["💎 VALOR"]
        V1["\"El 70% de clientes se enfrían\""]
        V2["\"Cuánto pierdes sin responder\""]
        V3["\"La auditoría es gratis\""]
        V4["Volver a INTERESADO"]
    end

    subgraph EJEMPLOS["📊 EJEMPLOS"]
